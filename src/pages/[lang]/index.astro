---
import Layout from '../../layouts/Layout.astro';
import IntroSplash from '../../components/IntroSplash.astro';
import HeroSection from '../../components/HeroSection.astro';
import ProductCard from '../../components/ProductCard.astro';
import QueueSection from '../../components/QueueSection.astro';
import ContactSection from '../../components/ContactSection.astro';
import { t } from '../../i18n/translations';
import { produtos } from '../../data/produtos';

export function getStaticPaths() {
  return ['pt', 'en', 'fr'].map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const tr = t(lang);
---

<Layout title={`KobaruFiles · ${tr.hero.eyebrow}`} lang={lang}>

  <IntroSplash lang={lang} />

  <HeroSection lang={lang} />

  <!-- Avatars -->
  <section id="avatares" class="cv-auto max-w-6xl mx-auto px-4 md:px-6 pt-16 md:pt-20 pb-16 md:pb-20 scroll-mt-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4">
      {produtos.map((produto, i) => (
        <ProductCard produto={produto} lang={lang} animDelay={i + 2} />
      ))}
    </div>
  </section>

  <QueueSection lang={lang} />

  <ContactSection lang={lang} />

</Layout>
