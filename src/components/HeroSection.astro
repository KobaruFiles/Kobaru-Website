---
import { t } from '../i18n/translations';

interface Props { lang: string; }
const { lang } = Astro.props;
const tr = t(lang);
---

<section id="hero" class="relative w-full overflow-hidden flex items-center justify-center hero-bg" style="min-height: 92vh;">

  <!-- Glow central rosa -->
  <div class="hero-glow absolute inset-0 flex items-center justify-center pointer-events-none">
    <div class="w-[500px] h-[240px] rounded-full" style="background: radial-gradient(ellipse, var(--pink-glow) 0%, transparent 65%);"></div>
  </div>

  <!-- Pétalas de sakura caindo, interativas com o mouse -->
  <canvas id="sakura-canvas" class="absolute inset-0 w-full h-full" aria-hidden="true"></canvas>

  <!-- Conteúdo -->
  <div class="relative z-10 text-center px-6 py-20 md:py-28 max-w-2xl mx-auto w-full">
    <p class="anim text-[10px] tracking-[0.4em] uppercase font-bold mb-6 c-dim">{tr.hero.eyebrow}</p>

    <h1 class="anim anim-d1 font-extrabold tracking-tight leading-[1.06] mb-6" style={`font-size: clamp(2.4rem, 7vw, 5rem); color: var(--text);`}>
      {tr.hero.line1}<br/>
      <span class="text-shimmer">{tr.hero.line2}</span>
    </h1>

    <p class="anim anim-d2 text-sm md:text-base max-w-lg mx-auto font-light leading-relaxed mb-10 c-muted">
      {tr.hero.sub}
    </p>

    <a
      href="#avatares"
      class="anim anim-d3 pay-btn btn-pink inline-flex items-center gap-2 font-bold px-7 py-3.5 md:px-9 md:py-4 rounded-full text-xs md:text-sm tracking-widest uppercase"
    >
      {tr.hero.cta}
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 5v14M5 12l7 7 7-7"/>
      </svg>
    </a>
  </div>

</section>

<style>
  .hero-bg {
    background:
      radial-gradient(ellipse 70% 55% at 50% 15%, var(--pink-bg-h) 0%, transparent 60%),
      linear-gradient(180deg, var(--pink-light) 0%, var(--bg) 78%);
  }
  :root[data-theme="dark"] .hero-bg {
    background:
      radial-gradient(ellipse 70% 55% at 50% 15%, var(--pink-bg-h) 0%, transparent 60%),
      linear-gradient(180deg, var(--bg-card) 0%, var(--bg) 78%);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .hero-bg {
      background:
        radial-gradient(ellipse 70% 55% at 50% 15%, var(--pink-bg-h) 0%, transparent 60%),
        linear-gradient(180deg, var(--bg-card) 0%, var(--bg) 78%);
    }
  }
  #sakura-canvas { display: block; }
</style>

<script>
  const canvas = document.getElementById('sakura-canvas') as HTMLCanvasElement | null;
  const section = document.getElementById('hero');
  if (canvas && section) {
    const ctx = canvas.getContext('2d');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (ctx) {
      let width = 0;
      let height = 0;
      let dpr = Math.min(window.devicePixelRatio || 1, 2);
      let pink = '#bf4068';
      let pinkShimmer = '#e0789e';

      const readColors = () => {
        const styles = getComputedStyle(document.documentElement);
        pink = styles.getPropertyValue('--pink').trim() || pink;
        pinkShimmer = styles.getPropertyValue('--pink-shimmer').trim() || pinkShimmer;
      };
      readColors();

      const isDesktop = window.innerWidth >= 768;
      const COUNT = isDesktop ? 34 : 16;
      const REPEL_RADIUS = 100;

      // Measure the canvas itself (CSS already stretches it to the section via inset-0)
      // rather than overriding its style, so layout stays the single source of truth.
      // Assigning canvas.width/height always clears the bitmap, so the static
      // reduced-motion rendering has to be re-issued after every resize.
      function resize() {
        width = canvas!.clientWidth;
        height = canvas!.clientHeight;
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas!.width = Math.max(1, Math.round(width * dpr));
        canvas!.height = Math.max(1, Math.round(height * dpr));
        ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
        if (reduceMotion) drawStatic();
      }

      function rand(min: number, max: number) {
        return min + Math.random() * (max - min);
      }

      class Petal {
        x = 0; y = 0; size = 0; fallSpeed = 0;
        swayAmp = 0; swaySpeed = 0; swayPhase = 0;
        rotation = 0; rotSpeed = 0; baseAlpha = 0;
        color = '';
        vx = 0; vyExtra = 0;

        constructor(fresh: boolean) {
          this.reset(fresh);
        }

        reset(fresh: boolean) {
          this.x = rand(0, width);
          this.y = fresh ? rand(-height * 0.9, height) : rand(-40, -10);
          this.size = rand(5, 11);
          this.fallSpeed = rand(0.35, 0.9);
          this.swayAmp = rand(0.4, 1.3);
          this.swaySpeed = rand(0.008, 0.02);
          this.swayPhase = rand(0, Math.PI * 2);
          this.rotation = rand(0, Math.PI * 2);
          this.rotSpeed = rand(-0.02, 0.02);
          this.baseAlpha = rand(0.35, 0.75);
          this.color = Math.random() > 0.5 ? pink : pinkShimmer;
          this.vx = 0;
          this.vyExtra = 0;
        }

        step(dt: number, mouse: { x: number; y: number } | null) {
          if (mouse) {
            const dx = this.x - mouse.x;
            const dy = this.y - mouse.y;
            const dist = Math.hypot(dx, dy);
            if (dist < REPEL_RADIUS && dist > 0.01) {
              const force = (1 - dist / REPEL_RADIUS) * 5.5;
              this.vx += (dx / dist) * force;
              this.vyExtra += (dy / dist) * force * 0.35;
            }
          }
          this.vx *= 0.93;
          this.vyExtra *= 0.93;

          this.swayPhase += this.swaySpeed * dt;
          this.x += Math.sin(this.swayPhase) * this.swayAmp * dt + this.vx * dt * 0.6;
          this.y += this.fallSpeed * dt + this.vyExtra * dt * 0.6;
          this.rotation += this.rotSpeed * dt;

          const fadeStart = height * 0.76;
          let alpha = this.baseAlpha;
          if (this.y > fadeStart) {
            alpha *= Math.max(0, 1 - (this.y - fadeStart) / (height - fadeStart));
          }

          if (this.y - this.size > height || alpha <= 0.01) {
            this.reset(false);
          }

          return alpha;
        }

        draw(ctx: CanvasRenderingContext2D, alpha: number) {
          ctx.save();
          ctx.translate(this.x, this.y);
          ctx.rotate(this.rotation);
          ctx.globalAlpha = alpha;
          ctx.fillStyle = this.color;
          const s = this.size;
          ctx.beginPath();
          ctx.moveTo(0, -s);
          ctx.bezierCurveTo(s * 0.85, -s * 0.55, s * 0.85, s * 0.55, 0, s);
          ctx.bezierCurveTo(-s * 0.85, s * 0.55, -s * 0.85, -s * 0.55, 0, -s);
          ctx.closePath();
          ctx.fill();
          ctx.restore();
        }
      }

      let petals: Petal[] = [];
      function seed() {
        if (petals.length || width <= 0 || height <= 0) return;
        petals = Array.from({ length: COUNT }, () => new Petal(true));
      }

      function drawStatic() {
        seed();
        ctx!.clearRect(0, 0, width, height);
        for (const p of petals) p.draw(ctx!, p.baseAlpha * 0.6);
      }

      // The hero content sits above the canvas, so listening on the canvas alone
      // would leave the petals unresponsive over the headline and the CTA.
      let mouse: { x: number; y: number } | null = null;
      section.addEventListener('mousemove', (e) => {
        const rect = canvas!.getBoundingClientRect();
        mouse = { x: e.clientX - rect.left, y: e.clientY - rect.top };
      });
      section.addEventListener('mouseleave', () => { mouse = null; });

      window.addEventListener('kobaru-theme-change', () => {
        readColors();
        for (const p of petals) p.color = Math.random() > 0.5 ? pink : pinkShimmer;
        if (reduceMotion) drawStatic();
      });

      let lastTime = 0;
      let rafId = 0;

      function frame(time: number) {
        rafId = 0;
        const dt = lastTime ? Math.min(time - lastTime, 42) / 16.6667 : 1;
        lastTime = time;
        seed();
        ctx!.clearRect(0, 0, width, height);
        for (const p of petals) {
          const alpha = p.step(dt, mouse);
          p.draw(ctx!, alpha);
        }
        start();
      }

      function start() {
        if (rafId || document.hidden || reduceMotion) return;
        rafId = requestAnimationFrame(frame);
      }

      resize();
      new ResizeObserver(resize).observe(canvas);

      if (!reduceMotion) {
        start();
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) {
            if (rafId) { cancelAnimationFrame(rafId); rafId = 0; }
          } else {
            lastTime = 0;
            start();
          }
        });
      }
    }
  }
</script>
