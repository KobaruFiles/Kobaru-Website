---
interface Props { lang: string; }
const { lang } = Astro.props;

const greetings: Record<string, string> = {
  pt: 'Seja bem-vindo',
  en: 'Welcome',
  fr: 'Bienvenue',
};
const greeting = greetings[lang] ?? greetings.pt;

// posições/atrasos fixos (build-time) pra cada pétala — sem aleatoriedade em runtime
const petals = Array.from({ length: 10 }, (_, i) => ({
  left: (i * 9.7 + 3) % 100,
  size: 9 + ((i * 7) % 10),
  duration: 7 + (i % 5),
  delay: -(i * 1.3),
  drift: i % 2 === 0 ? 1 : -1,
}));
---

<div class="intro-splash" id="intro-splash">
  <div class="intro-petals" aria-hidden="true">
    {petals.map((p) => (
      <span
        class="petal"
        style={`left:${p.left}%; width:${p.size}px; height:${p.size}px; animation-duration:${p.duration}s, ${p.duration * 0.6}s; animation-delay:${p.delay}s, ${p.delay}s;`}
        data-drift={p.drift}
      ></span>
    ))}
  </div>

  <div class="intro-content">
    <p class="intro-kanji">桜</p>
    <p class="intro-greeting">{greeting} · ようこそ</p>
    <p class="intro-word">Kobaru<span>Files</span></p>
    <div class="intro-line" aria-hidden="true"><span></span></div>
  </div>
</div>

<style>
  .intro-splash {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: radial-gradient(ellipse at 50% 30%, var(--pink-light) 0%, var(--bg) 70%);
    transition: opacity .7s ease, visibility .7s ease;
  }
  .intro-splash.is-leaving {
    opacity: 0;
    pointer-events: none;
  }

  .intro-petals {
    position: absolute;
    inset: 0;
  }
  .petal {
    position: absolute;
    top: -8%;
    display: block;
    background: linear-gradient(135deg, var(--pink-shimmer), var(--pink));
    opacity: .55;
    border-radius: 0% 60% 0% 60%;
    animation-name: petalFall, petalSway;
    animation-timing-function: linear, ease-in-out;
    animation-iteration-count: infinite, infinite;
    animation-direction: normal, alternate;
    transform: rotate(20deg);
  }
  .petal[data-drift="-1"] { animation-direction: normal, alternate-reverse; }

  @keyframes petalFall {
    0%   { top: -8%; }
    100% { top: 108%; }
  }
  @keyframes petalSway {
    0%   { margin-left: -18px; }
    100% { margin-left: 18px; }
  }

  .intro-content {
    position: relative;
    text-align: center;
    padding: 0 1.5rem;
  }

  .intro-kanji {
    font-family: 'Shippori Mincho', serif;
    font-size: 1.1rem;
    letter-spacing: .3em;
    color: var(--pink);
    opacity: 0;
    margin-bottom: .75rem;
    animation: introFadeUp .8s ease forwards;
    animation-delay: .15s;
  }

  .intro-greeting {
    font-family: 'Shippori Mincho', serif;
    font-size: clamp(.85rem, 2vw, 1.05rem);
    letter-spacing: .08em;
    color: var(--text-muted);
    opacity: 0;
    margin-bottom: 1.1rem;
    animation: introFadeUpOut 1.9s ease forwards;
    animation-delay: .45s;
  }

  .intro-word {
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    letter-spacing: .04em;
    color: var(--text);
    opacity: 0;
    transform: translateY(6px) scale(.97);
    animation: introFadeUp .8s ease forwards;
    animation-delay: 1.3s;
  }
  .intro-word span { color: var(--pink); }

  .intro-line {
    margin: 1.1rem auto 0;
    width: 130px;
    height: 1px;
    background: var(--border);
    overflow: hidden;
  }
  .intro-line span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--pink);
    animation: introLineDraw 1s ease forwards;
    animation-delay: 1.7s;
  }

  @keyframes introFadeUp {
    0%   { opacity: 0; transform: translateY(8px); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes introFadeUpOut {
    0%   { opacity: 0; transform: translateY(8px); }
    22%  { opacity: 1; transform: translateY(0); }
    62%  { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(-6px); }
  }
  @keyframes introLineDraw {
    to { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .petal { animation: none; display: none; }
    .intro-kanji, .intro-greeting, .intro-word { animation: none; opacity: 1; transform: none; }
    .intro-line span { animation: none; width: 100%; }
  }
</style>

<style is:global>
  html.intro-seen #intro-splash { display: none; }
  html:not(.intro-seen) body:has(#intro-splash) { overflow: hidden; }
</style>

<script>
  const splash = document.getElementById('intro-splash');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (splash && !sessionStorage.getItem('kobaru-intro-seen')) {
    let left = false;
    const leave = () => {
      if (left) return;
      left = true;
      splash.classList.add('is-leaving');
      document.documentElement.classList.add('intro-seen');
      sessionStorage.setItem('kobaru-intro-seen', '1');
      setTimeout(() => splash.remove(), 750);
    };

    const timer = setTimeout(leave, reduceMotion ? 200 : 2700);
    splash.addEventListener('click', () => { clearTimeout(timer); leave(); });
  } else if (splash) {
    splash.remove();
  }
</script>
