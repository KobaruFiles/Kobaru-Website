---
import { t } from '../i18n/translations';
import { DISCORD_URL } from '../data/payments';

interface Props { lang: string; }
const { lang } = Astro.props;
const tr = t(lang);

// posições/tempos fixos (build-time) — sem aleatoriedade em runtime
const leaves = Array.from({ length: 8 }, (_, i) => ({
  left: (i * 12.7 + 5) % 100,
  size: 8 + ((i * 5) % 8),
  duration: 9 + (i % 4) * 1.5,
  delay: -(i * 2.1),
  drift: i % 2 === 0 ? 1 : -1,
}));
---

<section id="contato" class="cv-auto border-t border-theme relative overflow-hidden">
  <!-- Folhinhas caindo — mesmo desenho das pétalas do hero, versão CSS leve -->
  <div class="contact-leaves absolute inset-0 pointer-events-none" aria-hidden="true">
    {leaves.map((l) => (
      <span
        class="leaf-fall"
        style={`left:${l.left}%; animation-duration:${l.duration}s; animation-delay:${l.delay}s;`}
      >
        <span
          class="leaf"
          style={`width:${l.size}px; height:${l.size}px; animation-duration:${l.duration * 0.55}s; animation-delay:${l.delay}s;`}
          data-drift={l.drift}
        ></span>
      </span>
    ))}
  </div>

  <div class="relative max-w-6xl mx-auto px-6 py-20 text-center">
    <p class="text-[10px] tracking-[0.35em] uppercase font-bold mb-4 c-dim">{tr.contact.label}</p>
    <h2 class="text-3xl font-extrabold mb-3" style="color: var(--text);">{tr.contact.title}</h2>
    <p class="text-sm mb-8 font-light c-muted">{tr.contact.sub}</p>
    <a href={DISCORD_URL} class="discord-btn pay-btn btn-outline inline-flex items-center gap-3 font-bold px-8 py-4 rounded-full text-sm tracking-wide">
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 127.14 96.36" fill="currentColor">
        <path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z"/>
      </svg>
      {tr.contact.cta}
    </a>
  </div>
</section>

<style>
  /* Hover no azul oficial do Discord (blurple) */
  .discord-btn:hover {
    border-color: #5865f2;
    background: #5865f2;
    color: #fff;
    box-shadow: 0 8px 22px -4px rgb(88 101 242 / 45%);
  }

  .contact-leaves { z-index: 0; }

  /* Queda no wrapper + balanço no miolo: só transform/opacity, tudo no compositor.
     A folha some com fade antes de chegar embaixo. */
  .leaf-fall {
    position: absolute;
    top: -18px;
    display: block;
    animation-name: leafFall;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    will-change: transform, opacity;
  }
  .leaf {
    display: block;
    background: linear-gradient(135deg, var(--pink-shimmer), var(--pink));
    border-radius: 0% 60% 0% 60%;
    animation-name: leafSway;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-direction: alternate;
    will-change: transform;
  }
  .leaf[data-drift="-1"] { animation-direction: alternate-reverse; }

  @keyframes leafFall {
    0%   { transform: translateY(0); opacity: 0; }
    8%   { opacity: .45; }
    72%  { opacity: .45; }
    96%  { opacity: 0; }
    100% { transform: translateY(430px); opacity: 0; }
  }
  @keyframes leafSway {
    0%   { transform: translateX(-14px) rotate(12deg); }
    100% { transform: translateX(14px) rotate(34deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .leaf-fall { display: none; }
  }
</style>
