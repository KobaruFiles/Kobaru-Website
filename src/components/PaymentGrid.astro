---
interface Gateway {
  href: string;
  label: string;
  color: string;
  icon: 'mp' | 'paypal' | 'stripe' | 'crypto';
}

interface Props {
  gateways: Gateway[];
  gap?: string;
  py?: string;
}

const { gateways, gap = 'gap-2.5', py = 'py-3.5' } = Astro.props;

// paypal/stripe/bitcoin path data from @fortawesome/free-brands-svg-icons (fill icons).
// Mercado Pago has no Font Awesome brand icon, so it uses a plain card glyph instead.
const icons: Record<Gateway['icon'], { viewBox: string; width: number; markup: string; fill?: boolean }> = {
  mp: {
    viewBox: '0 0 24 24',
    width: 16,
    markup: `<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3 10h18"/><path d="M7 15h4" stroke-linecap="round"/>`,
  },
  paypal: {
    viewBox: '0 0 384 512',
    width: 12,
    fill: true,
    markup: `<path d="M111.9 295.9c-3.5 19.2-17.4 108.7-21.5 134-.3 1.8-1 2.5-3 2.5l-74.6 0c-7.6 0-13.1-6.6-12.1-13.9L59.3 46.6c1.5-9.6 10.1-16.9 20-16.9 152.3 0 165.1-3.7 204 11.4 60.1 23.3 65.6 79.5 44 140.3-21.5 62.6-72.5 89.5-140.1 90.3-43.4 .7-69.5-7-75.3 24.2zM357.6 152c-1.8-1.3-2.5-1.8-3 1.3-2 11.4-5.1 22.5-8.8 33.6-39.9 113.8-150.5 103.9-204.5 103.9-6.1 0-10.1 3.3-10.9 9.4-22.6 140.4-27.1 169.7-27.1 169.7-1 7.1 3.5 12.9 10.6 12.9l63.5 0c8.6 0 15.7-6.3 17.4-14.9 .7-5.4-1.1 6.1 14.4-91.3 4.6-22 14.3-19.7 29.3-19.7 71 0 126.4-28.8 142.9-112.3 6.5-34.8 4.6-71.4-23.8-92.6z"/>`,
  },
  stripe: {
    viewBox: '0 0 384 512',
    width: 12,
    fill: true,
    markup: `<path d="M155.6 154.6c0-22.3 18.6-30.9 48.4-30.9 43.4 0 98.5 13.3 141.9 36.7l0-134.3c-47.3-18.9-94.5-26.1-141.8-26.1-115.7 0-192.8 60.4-192.8 161.4 0 157.9 216.8 132.3 216.8 200.4 0 26.4-22.9 34.9-54.7 34.9-47.2 0-108.2-19.5-156.1-45.5l0 128.5c49.3 21.3 102.3 32.3 156 32.4 118.6 0 200.3-51 200.3-153.6 0-170.2-218-139.7-218-203.9z"/>`,
  },
  crypto: {
    viewBox: '0 0 512 512',
    width: 16,
    fill: true,
    markup: `<path d="M8 256a248 248 0 1 1 496 0 248 248 0 1 1 -496 0zm354.3-35.3c4.9-33-20.2-50.7-54.6-62.6l11.1-44.7-27.2-6.8-10.9 43.5c-7.2-1.8-14.5-3.5-21.8-5.1l10.9-43.8-27.2-6.8-11.2 44.7c-5.9-1.3-11.7-2.7-17.4-4.1l0-.1-37.5-9.4-7.2 29.1s20.2 4.6 19.8 4.9c11 2.8 13 10 12.7 15.8l-12.7 50.9c.8 .2 1.7 .5 2.8 .9-.9-.2-1.9-.5-2.9-.7l-17.8 71.3c-1.3 3.3-4.8 8.4-12.5 6.5 .3 .4-19.8-4.9-19.8-4.9l-13.5 31.1 35.4 8.8c6.6 1.7 13 3.4 19.4 5l-11.3 45.2 27.2 6.8 11.2-44.7c7.2 2 14.4 3.8 21.7 5.6l-11.1 44.5 27.2 6.8 11.3-45.1c46.4 8.8 81.3 5.2 96-36.7 11.8-33.8-.6-53.3-25-66 17.8-4.1 31.2-15.8 34.7-39.9zm-62.2 87.2c-8.4 33.8-65.3 15.5-83.8 10.9l14.9-59.9c18.4 4.6 77.6 13.7 68.8 49zm8.4-87.7c-7.7 30.7-55 15.1-70.4 11.3l13.5-54.3c15.4 3.8 64.8 11 56.8 43z"/>`,
  },
};
---

<div class={`grid grid-cols-2 ${gap}`}>
  {gateways.map(({ href, label, color, icon }) => {
    const ic = icons[icon];
    const height = Math.round((ic.width * (Number(ic.viewBox.split(' ')[3]) / Number(ic.viewBox.split(' ')[2]))) * 10) / 10;
    return (
      <a
        href={href}
        class={`pay-btn flex items-center justify-center gap-2 font-bold ${py} rounded-2xl text-xs tracking-wide`}
        style={`background:${color}1f; border:1px solid ${color}4d; color:${color};`}
        onmouseover={`this.style.background='${color}38'; this.style.borderColor='${color}8c';`}
        onmouseout={`this.style.background='${color}1f'; this.style.borderColor='${color}4d';`}
      >
        <svg
          width={ic.width}
          height={ic.fill ? height : ic.width}
          viewBox={ic.viewBox}
          fill={ic.fill ? 'currentColor' : 'none'}
          stroke={ic.fill ? undefined : 'currentColor'}
          stroke-width={ic.fill ? undefined : '1.8'}
          stroke-linecap={ic.fill ? undefined : 'round'}
          stroke-linejoin={ic.fill ? undefined : 'round'}
          set:html={ic.markup}
        />
        {label}
      </a>
    );
  })}
</div>
